source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=mesa
export PACKAGE_VERSION=26.1.6
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/mesa/26.1.6/
rm -rf ${BUILD_DIRECTORY}/mesa-26.1.6
tar xvf ${DOWNLOADDIR}/mesa-26.1.6.tar.xz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/mesa-26.1.6
    

    export BINDGEN_EXTRA_CLANG_ARGS="--sysroot=${LINUX_SYSROOT_DIR}"

    tar xf ${RESOURCEDIR}/files/mesa-DirectX-Headers_git.tar.gz -C subprojects/
    mv subprojects/{mesa-DirectX-Headers_git,DirectX-Headers-1.0}


    VK_DRIVERS="amd, broadcom, freedreno, intel, intel_hasvk, panfrost, swrast, virtio, imagination, microsoft-experimental, nouveau, asahi, gfxstream"
    case "${ARCH_NAME}" in
	i686)
		MESA_EXTRA_PARM="-Dgallium-rusticl=false -Dintel-rt=disabled"
		;;
	mips*)
		VK_DRIVERS="amd, broadcom, freedreno, intel, intel_hasvk, panfrost, swrast, virtio, imagination, microsoft-experimental, nouveau, gfxstream"
		MESA_EXTRA_PARM="-Dgallium-rusticl=false -Dintel-rt=enabled"
		;;
	*)
		MESA_EXTRA_PARM="-Dgallium-rusticl=false -Dintel-rt=enabled"
		;;
    esac

    mkdir cross-build
    pushd cross-build
        meson ${MESON_CONFIG} \
	      -Dgallium-drivers="radeonsi,r300,r600,nouveau,freedreno,softpipe,v3d,vc4,etnaviv,tegra,svga,virgl,panfrost,lima,zink,d3d12,crocus,llvmpipe" \
              -Dplatforms=x11,wayland \
              -Dglx=dri -Dopengl=true -Degl=enabled -Dglvnd=enabled -Dllvm-orcjit=true \
              -Dgles1=enabled -Dgles2=enabled \
              -Dlibunwind=disabled -Dvulkan-drivers="${VK_DRIVERS}" \
              -Dvideo-codecs="vc1dec,h264dec,h264enc,h265dec,h265enc,av1dec,av1enc,vp9dec" \
	      -Dmicrosoft-clc=disabled \
              -Dllvm=enabled -Dshared-llvm=enabled -Ddraw-use-llvm=true -Dgallium-d3d12-video=auto -Dshader-cache-max-size=8G -Dglx-direct=true -Dvulkan-layers=device-select,overlay \
	      -Dbuild-tests=false -Dlmsensors=disabled ${MESA_EXTRA_PARM} \
              ..
	eval ${NINJA_AND_INSTALL}
    popd
popd 
rm -rf ${BUILD_DIRECTORY}/mesa-26.1.6
