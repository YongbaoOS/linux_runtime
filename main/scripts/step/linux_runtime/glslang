source env/linux_runtime/config
source env/distro.info
source env/function.sh
source env/linux_runtime/custom
export STEP_BUILDNAME=linux_runtime
export STEP_PACKAGENAME=glslang
export PACKAGE_VERSION=16.5.0
export RESOURCEDIR=${NEW_TARGET_SYSDIR}/files/linux_runtime/glslang/16.5.0/
rm -rf ${BUILD_DIRECTORY}/glslang-16.5.0
tar xvf ${DOWNLOADDIR}/glslang-16.5.0.tar.gz -C ${BUILD_DIRECTORY} 
pushd ${BUILD_DIRECTORY}/glslang-16.5.0
        
        mkdir cross-build
        pushd cross-build
                CC="${LINUX_HOST}-gcc" CXX="${LINUX_HOST}-g++" \
                cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release \
                      -DCMAKE_INSTALL_LIBDIR=/usr/lib${LIB_SUFF} \
                      -DCMAKE_TOOLCHAIN_FILE=${COMMON_DIR}/cmake-cross-${TAG_NAME}.cmake \
                      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
                      -DCMAKE_INSTALL_PREFIX=/usr \
                      -DBUILD_SHARED_LIBS=ON \
		      -DALLOW_EXTERNAL_SPIRV_TOOLS=ON \
                      -Wno-dev ..
                eval ${MAKE_AND_INSTALL}
        popd
        rm -f ${LINUX_SYSROOT_DIR}/usr/lib64/*.la
popd 
rm -rf ${BUILD_DIRECTORY}/glslang-16.5.0

if [ "x${PACKAGE_VERSION}" == "xgit-default" ]; then
        save_package_version ${LINUX_HOST}_${STEP_PACKAGENAME} "${PACKAGE_VERSION}_git"
else
        save_package_version ${LINUX_HOST}_${STEP_PACKAGENAME} "${PACKAGE_VERSION}"
fi
